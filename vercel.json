{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run typecheck",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "fixtures/weekly-events.json"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' https://rpc.botchain.ai https://rpc.bohr.life; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
