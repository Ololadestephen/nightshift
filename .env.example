# Copy to .env and keep the real file uncommitted.
# Values below are names only. Do not put a live key in this example.

NEATLOGS_API_KEY=
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
NIGHTSHIFT_MODEL=claude-haiku

# Set to 1 only after you explicitly approve use of the shared model budget.
NIGHTSHIFT_SPEND_APPROVED=

# Live runs also require both numbers. Neither has a default.
# NIGHTSHIFT_MODEL_BUDGET_USD is the process cap. NIGHTSHIFT_USD_PER_CALL is your estimate.
NIGHTSHIFT_MODEL_BUDGET_USD=
NIGHTSHIFT_USD_PER_CALL=

# Optional. When set, a browser must present this code before a session is created.
NIGHTSHIFT_INVITE_CODE=

# Set to 1 only on a trusted machine to expose labelled fault scenarios.
NIGHTSHIFT_LAB=

NIGHTSHIFT_HOST=127.0.0.1
NIGHTSHIFT_PORT=8787
